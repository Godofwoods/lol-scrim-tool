# Riot Games API
# Clé API développeur (expire toutes les 24h) : https://developer.riotgames.com/
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Région par défaut (EUW1, NA1, KR, etc.)
RIOT_REGION=europe
RIOT_PLATFORM=euw1

# Préfixe de l'équipe pour la détection de scrims
TEAM_TAG=FIS

# Nombre minimum de joueurs avec le tag dans l'équipe pour considérer un scrim
MIN_TEAM_PLAYERS=3
